# Plantilla del entorno de pruebas. Copiar a `.env.test` y completar las
# credenciales locales de PostgreSQL.
#
# La suite recrea el esquema de `DB_NAME` en cada ejecucion: el setup aborta si
# `NODE_ENV` no es `test` o si `DB_NAME` no termina en `_test`.

# Server configuration
NODE_ENV=test
PORT=4501
DEFAULT_LANGUAGE=es
SUPPORTED_LANGUAGES=es,en,nl

# CORS
CORS_ORIGINS=http://localhost:3000

# Database configuration
# DB_NAME debe terminar en `_test`. Nunca apuntar a la base de desarrollo.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=esavi_test
DB_USER=ESAVI_USER_DB
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO
DB_SSL=false

# Base de mantenimiento usada para hacer DROP/CREATE de DB_NAME
DB_MAINTENANCE_NAME=postgres

# SEED
SEED_ACTION=test
ESAVI_SUPERADMIN_X=superadmin@test.local
ESAVI_SUPERADMIN_Y=superadminpassword
ESAVI_ADMIN_X=admin@test.local
ESAVI_ADMIN_Y=adminpassword

ESAVI_SUPERADMIN=SUPERADMIN_ROLE
ESAVI_ADMIN=ADMIN_ROLE
ESAVI_USER=USER_ROLE
ESAVI_ANALYTICS=ANALYTICS_ROLE

# JSON WEB TOKEN
JWT_SECRET=test_jwt_secret_not_for_production
JWT_EXPIRES_IN=8h

# CRYPTO
CRYPTO_ALGORITHM=aes-256-cbc
CRYPTO_SECRET_KEY=test_crypto_secret_key_change_me
CRYPTO_VECTOR=test_crypto_vector

# APP CONFIG
ESAVI_APP_COUNTRY=Ecuador
ESAVI_APP_CODE=ECU
ESAVI_APP_DEFAULT_LIMIT=10
ESAVI_APP_DEFAULT_OFFSET=0
