# Server configuration
NODE_ENV=development
PORT=4500
DEFAULT_LANGUAGE=es
SUPPORTED_LANGUAGES=es,en,nl

# CORS
# Comma-separated list of allowed origins, without trailing slash.
# Optional outside production (defaults to http://localhost:5173,http://localhost:3000).
# Mandatory when NODE_ENV=production: the server exits at startup if it is missing.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Database configuration
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=ESAVI_DB_NAME
DB_USER=ESAVI_USER_DB
DB_PASSWORD=CAMBIAR_PASSWORD_SEGURO
DB_SSL=false

# SEED
SEED_ACTION=none
ESAVI_SUPERADMIN_X=superadmin@xxyyzz.com
ESAVI_SUPERADMIN_Y=superadminpassword
ESAVI_ADMIN_X=admin@xxyyzz.com
ESAVI_ADMIN_Y=adminpassword

ESAVI_SUPERADMIN=SUPERADMIN_ROLE
ESAVI_ADMIN=ADMIN_ROLE
ESAVI_USER=USER_ROLE

# JSON WEB TOKEN
JWT_SECRET=CAMBIAR_JWT_SECRET
JWT_EXPIRES_IN=1h

# SESSION / REFRESH TOKEN
# Optional. Defaults live in src/constants/session.constants.ts ('8h' and '30d').
# REFRESH_TOKEN_EXPIRES_IN  sliding lifetime of a refresh token; every renewal pushes it again.
# REFRESH_ABSOLUTE_MAX_IN   ceiling counted from appSession.startedAt, which never moves.
REFRESH_TOKEN_EXPIRES_IN=8h
REFRESH_ABSOLUTE_MAX_IN=30d

# CRYPTO
CRYPTO_ALGORITHM=algoritmo_de_cifrado
CRYPTO_SECRET_KEY=cAm81aR_crIp70_$secr37_K3y
CRYPTO_VECTOR=cAm81aR_crIp70_V3ct04

# APP CONFIG
ESAVI_APP_COUNTRY=Ecuador
ESAVI_APP_CODE=ECU
ESAVI_APP_DEFAULT_LIMIT=10
ESAVI_APP_DEFAULT_OFFSET=0
# MEDDRA — SPEC F55
# Fallback only: the authoritative source for these eight is systemConfig, scope MEDDRA
# (POST /api/system-configs/sync seeds them). The row wins, the variable is the fallback.
# ESAVI_MEDDRA_ENABLED   the general switch; anything but true/1 keeps ESAVI-MEDDRA-006 at 503
# ESAVI_MEDDRA_USERNAME / _PASSWORD   licence credentials. Load them with ESAVI-SYSCONF-004,
#                                     where they are stored encrypted, and leave them empty here
# ESAVI_MEDDRA_SEARCH_CONFIG   the whole search body as a single JSON line
ESAVI_MEDDRA_ENABLED=
ESAVI_MEDDRA_USERNAME=
ESAVI_MEDDRA_PASSWORD=
ESAVI_MEDDRA_TOKEN_URL=https://mid.meddra.org/connect/token
ESAVI_MEDDRA_SEARCH_URL=https://mapisbx.meddra.org/api/search
ESAVI_MEDDRA_CLIENT_ID=mspclient
ESAVI_MEDDRA_OAUTH_SCOPE=meddraapi
ESAVI_MEDDRA_SEARCH_CONFIG=
